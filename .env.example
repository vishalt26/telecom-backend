DB_URL=jdbc:mysql://localhost:3306/telecom_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
# at least 32 random characters
JWT_SECRET=a_long_random_string_at_least_32_chars
JWT_EXPIRY_MINUTES=30
# comma-separated exact origins (no wildcard)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# first admin account, created on startup if no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password_1
# local dev only: loads FAKE demo staff/customers/tickets
SEED_DEMO=false
DEMO_PASSWORD=choose_a_demo_password_1
